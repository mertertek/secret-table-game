# Secret Table — environment variables (example)
# Copy this file first: `cp .env.example .env`, then fill in real values. `.env` is git-ignored.
# Without any of these, the app runs in IN-MEMORY MODE: no Supabase, no accounts,
# state lives in the dev server process. Good enough to play a full local game.
# Vite reads this file from the repository root (apps/web/vite.config.ts -> envDir).
# `VITE_`-prefixed variables are bundled into the browser; the rest are server-only
# (Vercel Functions).

# --- Exposed to the browser (publishable) ---
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-SUPABASE-PUBLISHABLE-KEY"

# --- Server only (Vercel Functions) ---
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SECRET_KEY="YOUR-SUPABASE-SECRET-KEY"
APP_ORIGIN="http://localhost:5173"
ROOM_RECONNECT_SECONDS="600"

# --- Supabase CLI only (migrations: link + db push) ---
SUPABASE_PROJECT_REF="YOUR-PROJECT-REF"
SUPABASE_ACCESS_TOKEN="sbp_XXXXXXXX"       # dashboard/account/tokens
SUPABASE_DB_PASSWORD="YOUR-DB-PASSWORD"

# When Supabase is not configured, the API falls back to a fake "dev:<id>" identity
# plus the in-memory gateway. The gate: whenever VERCEL_ENV is production or preview
# this is ALWAYS off and the flag below is IGNORED. It only applies locally and to
# `vercel dev` (VERCEL_ENV=development). An empty or placeholder env value counts as
# "not set".
# SECRET_TABLE_ALLOW_DEV_AUTH="1"
